# Copy this file to .env and replace every PLACEHOLDER value locally.
# Never commit real credentials or machine-specific paths.

AI_PROVIDER=PLACEHOLDER_PROVIDER

DEEPSEEK_API_KEY=PLACEHOLDER_API_KEY
DEEPSEEK_BASE_URL=PLACEHOLDER_BASE_URL
DEEPSEEK_MODEL=PLACEHOLDER_MODEL

ODA_FILE_CONVERTER=PLACEHOLDER_FULL_PATH_TO_ODA_FILE_CONVERTER_EXECUTABLE

AUTOCAD_AI_DB_PATH=PLACEHOLDER_FULL_PATH_TO_JOBS_DB

AUTOCAD_AI_TAG_PROXIMITY_MM=PLACEHOLDER_DISTANCE_MM
AUTOCAD_AI_TAG_AMBIGUITY_MM=PLACEHOLDER_DISTANCE_MM

USERNAME=PLACEHOLDER_WINDOWS_USERNAME
USER=PLACEHOLDER_USERNAME
